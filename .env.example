# Copy to backend/.env and fill in. Placeholders only — never commit real values.
DATABASE_URL=sqlite:///./trial.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URL of the backend (used in verification/reset links)
APP_URL=http://127.0.0.1:8002
FRONTEND_URL=http://localhost:5174

# --- Email provider (SMTP is the documented live provider) ---
EMAIL_PROVIDER=dryrun
# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Resend HTTP API (alternative live provider) ---
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=

# --- Global trade intelligence (UN Comtrade) ---
# un_comtrade = real UN Comtrade data; none = module disabled (honest 503s).
TRADE_PROVIDER=un_comtrade
# Optional subscription key for the paid /data/v1/get endpoint.
# Leave empty to use the free public preview (rate-limited, 500 records/call,
# one period/call). Server-side only — never sent to the browser.
UN_COMTRADE_API_KEY=
TRADE_TIMEOUT=30
TRADE_MAX_RETRIES=3
TRADE_MIN_INTERVAL=2.0
TRADE_CACHE_TTL_HOURS=24
TRADE_REFERENCE_TTL_HOURS=24

# --- Google OAuth (Sign in with Google + Gmail send) ---
# Leave empty to hide the Google button. When set, users get one consent
# for login + gmail.send. Redirect URI must match Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/api/auth/google/callback
# EMAIL_PROVIDER=gmail  (plus the two lines above) sends via users' Gmail

# --- AI (Gemini) — optional, server-side only ---
# Leave empty for the deterministic template analyst (no AI, no network).
# When set, AI narratives are labelled engine=gemini and every number is
# validated against the computed facts before being shown.
GEMINI_API_KEY=

# --- Trial quotas (raised high; override per env as needed) ---
DAILY_CRAWL_PAGES=100000
DAILY_EMAIL_LIMIT=2000
MAX_CRAWL_PAGES=10000
MAX_CAMPAIGN_RECIPIENTS=5000

# --- Browser rendering fallback (JS-heavy pages) ---
# Set PLAYWRIGHT_ENABLED=false where Chromium can't run (tiny containers).
PLAYWRIGHT_ENABLED=true
MAX_RENDER_PAGES=10
