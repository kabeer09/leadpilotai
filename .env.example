# Copy to backend/.env and fill in. Placeholders only — never commit real values.
DATABASE_URL=sqlite:///./trial.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URL of the backend (used in verification/reset links)
APP_URL=http://127.0.0.1:8002
FRONTEND_URL=http://localhost:5174

# --- Email provider (SMTP is the documented live provider) ---
EMAIL_PROVIDER=dryrun
# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Resend HTTP API (alternative live provider) ---
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=

# --- Google OAuth (Sign in with Google + Gmail send) ---
# Leave empty to hide the Google button. When set, users get one consent
# for login + gmail.send. Redirect URI must match Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/api/auth/google/callback
# EMAIL_PROVIDER=gmail  (plus the two lines above) sends via users' Gmail

# --- Trial quotas ---
DAILY_CRAWL_PAGES=100
DAILY_EMAIL_LIMIT=50
MAX_CRAWL_PAGES=30
MAX_CAMPAIGN_RECIPIENTS=100

# --- Browser rendering fallback (JS-heavy pages) ---
# Set PLAYWRIGHT_ENABLED=false where Chromium can't run (tiny containers).
PLAYWRIGHT_ENABLED=true
MAX_RENDER_PAGES=10
